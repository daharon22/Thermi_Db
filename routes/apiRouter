var express = require('express');
const appRoot = require("app-root-path");
var router = express.Router();
const devices = appRoot.require("/controllers/devices");
const login = appRoot.require("/controllers/login");
const signup = appRoot.require("/controllers/signup");

//ADD for /newdevice
//router.get('/newdevicevent', signup.showSignupForm);
router.post('/newdeviceevent', apiRequest, devices.processDeviceEvent);
router.post('/gettemp', apiRequest, devices.getLastTemp);
router.post('/login', apiRequest, login.processLoginRequest, login.addFcmToken);
router.post('/signup', apiRequest, signup.processSignupRequest);
router.post('/addfcmtoken', apiRequest, login.addFcmToken);
router.post('/getMaxTemp', apiRequest, devices.getMaxTemp);
router.post('/setMaxTemp', apiRequest, devices.setMaxTemp);
router.post('/newdevice', apiRequest, devices.registerNewDevice)

async function apiRequest(req,res,next)
{
    req.API = true;
    next();
}

module.exports = router;